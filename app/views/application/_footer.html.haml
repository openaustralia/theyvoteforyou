-# OAF Standard Footer v2.0.1, translated to HAML from oaf-footer.html.
-# Source: https://github.com/openaustralia/oaf-standard-footer
-# Styles: vendor/assets/stylesheets/_oaf-footer.scss (copied unmodified from the same version).
-#
-# The attribution block is governed copy, byte-identical to the OAF Design
-# System. Do not paraphrase or reflow it - changing it changes public copy on
-# every OAF site at once and needs CEO sign-off.
%footer.oaf-footer.oaf-footer--they-vote-for-you
  .oaf-footer__inner
    .oaf-footer__top
      .oaf-footer__site
        %h2.oaf-footer__site-name They Vote For You
        .oaf-footer__site-description
          %p
            A site dedicated to making parliamentary voting information accessible,
            understandable, and easy to use so that you can hold your elected representatives to account.

      %nav.oaf-footer__links{"aria-label" => "Footer"}
        %ul
          %li= link_to "About", about_path
          %li= link_to "API", help_data_path
          %li= link_to "Blog", "https://www.oaf.org.au/blog/"
          %li= link_to "Help/FAQ", help_faq_path
        %ul
          %li= link_to "Licensing", help_licencing_path
          %li= link_to "Recent changes", history_path
          %li= link_to "Report an issue", "https://github.com/openaustralia/theyvoteforyou/issues", title: "Report a bug or contribute an idea"

      .oaf-footer__donate
        %p Help keep They&nbsp;Vote&nbsp;For&nbsp;You trusted and independent
        = link_to "Donate Now", "https://www.oaf.org.au/donate/", class: "oaf-footer__donate-button"

