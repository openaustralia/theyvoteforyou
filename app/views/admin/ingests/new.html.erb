<% content_for(:title) { "Upload AI summary drafts" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title"><%= content_for(:title) %></h1>
</header>

<section class="main-content__body">
  <p>
    Upload a zip of draft division summaries. It is queued and read in the background, and each
    draft is saved against its division for an editor to review. Nothing is published.
  </p>

  <p>Inside the zip, each draft is one file:</p>
  <pre>[model-name]/[house]/[yyyy-mm-dd]/[house]_[yyyy-mm-dd]_[n].md</pre>
  <ul>
    <li>The first folder is the model, which the draft is credited to. For example <code>local.Qwen3.6-35B-A3B-UD-Q4_K_M</code>.</li>
    <li>The file name says which division it is: <code>representatives_2026-09-17_3.md</code> is the division at <code>/divisions/representatives/2026-09-17/3</code>. The house and date folders are only for browsing.</li>
    <li>The first line is the draft's title, as a heading. The rest is the description.</li>
    <li>If any file is for a division we don't have, or is badly named, the whole upload fails and nothing is saved. Uploading again from the same model replaces its earlier draft for a division.</li>
  </ul>

  <%= form_with url: admin_ingests_path, multipart: true, local: true do |form| %>
    <%= hidden_field_tag :kind, @kind %>

    <%# A drop zone around the ordinary file input. The input still works on its own, so choosing a
        file keeps working without JavaScript. The script below only adds dropping a file on it. %>
    <div id="ingest-dropzone" style="padding: 2rem 1.5rem; margin: 0 0 1rem; text-align: center; background: #f6f8fa; border: 2px dashed #9aa5b1; border-radius: 8px;">
      <p style="margin: 0 0 0.75rem; font-size: 1.1em;"><strong>Drop a zip file here</strong>, or choose one:</p>
      <%= file_field_tag :file, accept: ".zip,application/zip", required: true, "aria-describedby": "ingest-dropzone-status" %>
      <p id="ingest-dropzone-status" role="status" style="margin: 0.75rem 0 0; min-height: 1.4em;"></p>
    </div>

    <div class="form-actions"><%= submit_tag "Upload", class: "button" %></div>
  <% end %>

  <script>
    (function () {
      var zone = document.getElementById("ingest-dropzone");
      var input = document.getElementById("file");
      var status = document.getElementById("ingest-dropzone-status");
      if (!zone || !input || !window.DataTransfer) { return; }

      var idle = { background: "#f6f8fa", borderColor: "#9aa5b1" };
      var active = { background: "#e8f0fb", borderColor: "#1a4f8f" };
      function paint(colours) { zone.style.background = colours.background; zone.style.borderColor = colours.borderColor; }

      function describe() {
        var file = input.files && input.files[0];
        status.style.color = "";
        status.textContent = file ? "Ready to upload: " + file.name + " (" + Math.max(1, Math.round(file.size / 1024)) + " KB)" : "";
      }

      // A file dropped outside the zone would make the browser open it and leave this page.
      ["dragover", "drop"].forEach(function (name) {
        window.addEventListener(name, function (event) { event.preventDefault(); });
      });

      zone.addEventListener("dragenter", function () { paint(active); });
      zone.addEventListener("dragover", function (event) { event.preventDefault(); paint(active); });
      zone.addEventListener("dragleave", function (event) { if (!zone.contains(event.relatedTarget)) { paint(idle); } });

      zone.addEventListener("drop", function (event) {
        event.preventDefault();
        paint(idle);
        var files = event.dataTransfer && event.dataTransfer.files;
        if (!files || files.length === 0) { return; }
        if (files.length > 1 || !/\.zip$/i.test(files[0].name)) {
          status.style.color = "#a61b1b";
          status.textContent = "Drop a single .zip file.";
          return;
        }
        input.files = files;
        describe();
      });

      input.addEventListener("change", describe);
    })();
  </script>
</section>
