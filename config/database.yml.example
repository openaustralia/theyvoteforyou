# Copy this to database.yml. The defaults match the MySQL container started by
# `make services-up`, so no edits are needed for a normal setup. DB_PORT moves
# it (see "Port clashes" in AGENTS.md).

default: &default
  adapter: mysql2
  host: <%= ENV.fetch("DB_HOST", "127.0.0.1") %>
  port: <%= ENV.fetch("DB_PORT", 3306) %>
  username: root
  password: <%= ENV.fetch("MYSQL_ROOT_PASSWORD", "root") %>

development:
  <<: *default
  database: tvfy-development

# Warning: The database defined as "test" will be erased and
# re-generated from your development database when you run "rake".
# Do not set this db to the same as development or production.
test:
  <<: *default
  database: tvfy-test
